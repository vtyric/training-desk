{
    "name": "@training-desk/source",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.12.4",
    "engines": {
        "node": ">=22.12.0 <25"
    },
    "scripts": {
        "start": "nx run service-desk:dev",
        "start:back": "nx run service-desk:serve-api",
        "start:front": "nx run service-desk:serve-ui",
        "build": "nx build service-desk && nx run identity:theme-build",
        "typecheck": "tsc --noEmit -p apps/service-desk/tsconfig.server.json && ngc --noEmit -p apps/service-desk/ui/tsconfig.app.json",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "tsx --env-file=.env --test tests/*.test.ts libs/auth/auth.test.ts libs/settings/settings.test.ts apps/service-desk/src/dal/migrate.test.ts",
        "setup:env": "node tools/setup-env.mjs",
        "setup:project": "node tools/bootstrap.mjs",
        "agents:check": "node tools/check-agent-docs.mjs",
        "infra:start": "docker compose -f compose.yaml -f infra/compose/dev.yaml up -d --wait --wait-timeout 180 postgres ldap identity",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "tsx --env-file=.env apps/service-desk/src/dal/migrate.ts",
        "db:seed": "tsx --env-file=.env apps/service-desk/src/dal/seed.ts",
        "contracts:sync": "node tools/sync-contract.mjs",
        "docker:start": "docker compose up --build -d --wait",
        "docker:stop": "docker compose down",
        "docker:logs": "docker compose logs -f --tail=100",
        "docker:check": "docker compose config --quiet",
        "docker:test": "node --env-file=.env tools/identity-smoke.mjs",
        "identity:configure": "node --env-file=.env tools/configure-identity.mjs",
        "identity:start": "docker compose up --build -d --wait identity",
        "service-desk:start": "docker compose up --build -d --wait service-desk",
        "identity:test-users": "node --env-file=.env tools/identity-smoke.mjs --manage-users",
        "hooks:install": "git config --local core.hooksPath .githooks",
        "precommit": "pnpm format:check && pnpm lint",
        "swagger:test": "node --env-file=.env tools/identity-smoke.mjs --swagger",
        "db:consolidate": "node --env-file=.env tools/migrate-identity-database.mjs --apply"
    },
    "dependencies": {
        "@angular/cdk": "21.2.14",
        "@angular/common": "21.2.17",
        "@angular/compiler": "21.2.17",
        "@angular/core": "21.2.17",
        "@angular/forms": "21.2.17",
        "@angular/platform-browser": "21.2.17",
        "@angular/router": "21.2.17",
        "@fastify/static": "8.3.0",
        "@fastify/swagger": "9.5.1",
        "@fastify/swagger-ui": "5.2.3",
        "@primeuix/themes": "2.0.3",
        "drizzle-orm": "0.45.2",
        "fastify": "5.10.0",
        "jose": "6.1.3",
        "keycloak-js": "26.2.2",
        "postgres": "3.4.9",
        "primeng": "21.1.9",
        "rxjs": "7.8.2",
        "tslib": "2.8.1"
    },
    "devDependencies": {
        "@angular/build": "21.2.17",
        "@angular/compiler-cli": "21.2.17",
        "@eslint/js": "9.39.1",
        "@nx/angular": "23.0.1",
        "@types/node": "22.19.0",
        "drizzle-kit": "0.31.10",
        "esbuild": "0.25.12",
        "eslint": "9.39.1",
        "eslint-config-prettier": "10.1.8",
        "nx": "23.0.1",
        "prettier": "3.6.2",
        "sass": "1.97.3",
        "tsx": "4.20.6",
        "typescript": "5.9.3",
        "typescript-eslint": "8.46.3"
    }
}
