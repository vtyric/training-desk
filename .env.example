NODE_ENV=development
BASE_URL=http://localhost:4200
DATABASE_URL=postgres://training:CHANGE_ME@localhost:55439/training
POSTGRES_PASSWORD=CHANGE_ME
ADMIN_TOKEN=CHANGE_ME
TEAM_API_TOKEN=CHANGE_ME
CUSTOMER_API_TOKEN=CHANGE_ME
LDAP_ADMIN_PASSWORD=CHANGE_ME
LDAP_ALICE_PASSWORD=CHANGE_ME
LDAP_SUPPORT_PASSWORD=CHANGE_ME
LDAP_DENIED_PASSWORD=CHANGE_ME

# Docker has its own origin; local pnpm start keeps BASE_URL on port 4200.
DOCKER_BASE_URL=http://localhost:8080
DOCKER_HTTP_PORT=8080
DOCKER_BIND_ADDRESS=127.0.0.1
DOCKER_NODE_ENV=development
# Workaround for Docker Desktop Bake shared contexts with non-ASCII project paths.
COMPOSE_BAKE=false

# Independent identity provider (Keycloak + LDAP) and OIDC relying party.
IDENTITY_DB_PASSWORD=CHANGE_ME
IDENTITY_ADMIN_USERNAME=administrator
IDENTITY_ADMIN_PASSWORD=CHANGE_ME
IDENTITY_PUBLIC_URL=http://localhost:8081
IDENTITY_HTTP_PORT=8081
IDENTITY_BIND_ADDRESS=127.0.0.1
OIDC_ISSUER_URL=http://localhost:8081/realms/training
# Swagger dev API origin; callback is /docs/static/oauth2-redirect.html.
API_DOCS_DEV_URL=http://localhost:3000
STUDENT_ORIGIN=http://localhost:4300
STUDENT_REDIRECT_URI=http://localhost:4300/auth/callback
WEBHOOK_SIGNING_SECRET=CHANGE_ME
SETTINGS_FILE=.local/settings/backend.json

# Demo Service Desk admin (separate from Keycloak administrator).
DESK_ADMIN_PASSWORD=CHANGE_ME

# Server-only read access to the Identity employee directory.
IDENTITY_DIRECTORY_CLIENT_SECRET=CHANGE_ME

# Default support lead account, managed through Keycloak after bootstrap.
SUPPORT_LEAD_PASSWORD=CHANGE_ME
