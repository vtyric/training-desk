{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "experimentalDecorators": true,
        "lib": ["ES2022", "DOM"],
        "types": ["node"],
        "baseUrl": ".",
        "paths": {
            "@training-desk/ui": ["libs/ui/src/index.ts"],
            "@training-desk/ui/theme": ["libs/ui/src/theme.ts"]
        }
    }
}
